# Пример для отдельного хостинга фронта. dist/ лежит в /usr/share/nginx/html.
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
  # SPA: любой путь без файла отдаёт index.html
  location / { add_header Cache-Control "no-cache"; try_files $uri /index.html; }

  # Если API на том же домене, раскомментируйте (CORS тогда не нужен):
  # location /api/ { proxy_pass http://backend:8000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme; }
}
