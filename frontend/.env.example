# Куда Vite проксирует /api в режиме разработки (адрес бэкенда)
VITE_PROXY_TARGET=http://localhost:8000
# Базовый путь API в браузере. Меняйте, только если фронт и бэкенд на разных доменах (тогда нужен CORS с credentials)
VITE_API_URL=/api/v1
# Пример для раздельного хостинга: VITE_API_URL=https://api.example.kz/api/v1
# Значение вшивается при `npm run build`. Бэкенд тогда должен разрешить CORS для домена фронта:
# Access-Control-Allow-Credentials: true, Allow-Headers: Content-Type, X-Requested-With, Allow-Origin: точный домен (не *),
# а cookie сессии ставиться с SameSite=None; Secure (иначе браузер не отправит её на другой домен).
